# Regenerated by `npm run vendor` on every build (ci.yml, pages.yml,
# release.yml); unlike d3.min.js, too large (~11MB: the compiler plus its
# lib.*.d.ts files) to keep in git history for something a build step
# produces from node_modules/typescript every time. Opening index.html
# straight from a clone (no build step) works for everything except the
# local-folder feature, which needs this to exist — run `npm run vendor` once.
site/vendor/typescript.js
site/vendor/typescript.LICENSE
site/vendor/ts-lib/
# Copy of analyzers/ts/core.mjs and analyzers/ts/svelte.mjs (our own code):
# keep those files the single source of truth rather than committing a
# duplicate that could drift.
site/vendor/analyzer-core.js
site/vendor/svelte-analyzer.js
# svelte2tsx + svelte/compiler bundled for the browser (scripts/vendor.mjs);
# same reasoning as typescript.js above.
site/vendor/svelte2tsx.js
